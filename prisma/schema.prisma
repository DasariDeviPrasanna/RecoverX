generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
  ABANDONED
  REFUNDED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecoveryStatus {
  PENDING
  ANALYZING
  RETRYING
  MESSAGE_SENT
  RECOVERED
  FAILED
  STOPPED
}

enum RecoveryActionType {
  RETRY_PAYMENT
  SEND_MESSAGE
  SEND_REMINDER
  ESCALATE
  STOP
}

enum AuditActor {
  SYSTEM
  AI_AGENT
  MERCHANT
}

model User {
  id           String   @id @default(cuid())
  firebaseUid  String   @unique
  name         String
  email        String   @unique
  businessName String?

  customers  Customer[]
  payments   Payment[]
  recoveries RecoveryAction[]
  auditLogs  AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  email         String
  phone         String?
  language      String   @default("English")
  lifetimeValue Float    @default(0)
  riskScore     Int      @default(0)

  payments   Payment[]
  recoveries RecoveryAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, email])
  @@index([userId])
}

model Payment {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  amount        Float
  status        PaymentStatus
  failureReason String?

  riskScore Int       @default(0)
  riskLevel RiskLevel @default(LOW)

  recoveryStatus RecoveryStatus @default(PENDING)
  retryCount     Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recoveries RecoveryAction[]
  auditLogs  AuditLog[]

  @@index([userId])
  @@index([customerId])
}

model RecoveryAction {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  actionType      RecoveryActionType
  status          RecoveryStatus
  reason          String?
  aiConfidence    Float?
  amountRecovered Float              @default(0)
  attemptNumber   Int                @default(1)

  executedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([paymentId])
  @@index([customerId])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  actor    AuditActor
  event    String
  action   String?
  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([paymentId])
}